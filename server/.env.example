# Copy to server/.env. Generate independent hexadecimal passwords; never commit .env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
FITNESS_OWNER_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_PASSWORD
FITNESS_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://fitness_app:REPLACE_WITH_RANDOM_APP_PASSWORD@localhost:5432/fitness_dev
# At least 48 random characters. Example generator: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS_FROM_GENERATOR
ACCESS_MINUTES=15
REFRESH_DAYS=30
AUTH_LIMIT=20
AUTH_WINDOW_SECONDS=60
CORS_ORIGINS=[]
API_DOMAIN=api.example.com
